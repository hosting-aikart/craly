# Backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# ─── MSG91 OTP Widget (phone verification on signup) ───────────────────────
# Client-side config for the widget SDK loaded on the signup page — see
# app/signup/page.tsx and backend/.env.example for the full architecture.
# These are intentionally public: MSG91 documents both as Web SDK
# configuration, not backend secrets. The backend never reads either var;
# its own MSG91_AUTH_KEY (a real secret) is what verifies the widget's
# resulting access-token server-side.
#
# Setup: MSG91 dashboard → OTP → Widgets → your widget → copy its Widget
# ID into NEXT_PUBLIC_MSG91_WIDGET_ID. For NEXT_PUBLIC_MSG91_TOKEN_AUTH,
# use the widget-scoped Token (MSG91 dashboard → OTP → Token → Generate
# New Token) — not the account Authkey.
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_TOKEN_AUTH=
