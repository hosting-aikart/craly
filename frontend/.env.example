# Backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# ─── MSG91 OTP Widget — NOT part of the active signup flow ─────────────────
# Signup verification is email-only; the signup page no longer loads the
# MSG91 widget SDK, and nothing currently reads either var below. NOT
# REQUIRED for the app to run. Kept documented here only so phone
# verification can be reintroduced later without rediscovering the setup
# — see backend/.env.example for the full architecture. Both are
# intentionally public (MSG91 documents them as Web SDK configuration,
# not backend secrets) — the backend never reads either var; its own
# MSG91_AUTH_KEY (a real secret) is what would verify the widget's
# resulting access-token server-side.
#
# Setup (if reintroduced): MSG91 dashboard → OTP → Widgets → your widget →
# copy its Widget ID into NEXT_PUBLIC_MSG91_WIDGET_ID. For
# NEXT_PUBLIC_MSG91_TOKEN_AUTH, use the widget-scoped Token (MSG91
# dashboard → OTP → Token → Generate New Token) — not the account Authkey.
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_TOKEN_AUTH=
