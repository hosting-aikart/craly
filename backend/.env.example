# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ─── PostgreSQL (postgres.js connection string) ───────────────────────────────
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://postgres:password@localhost:5432/craly

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (Next.js dev server)
ALLOWED_ORIGINS=http://localhost:3000

# ─── Frontend ────────────────────────────────────────────────────────────────
# Used to build absolute links back to the app in emails (e.g. "View Enquiry").
FRONTEND_URL=http://localhost:3000

# ─── Auth ────────────────────────────────────────────────────────────────────
# Secret used to sign JWTs. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Contact form + OTP email (Resend) ─────────────────────────────────────
# Get a free API key at https://resend.com/api-keys
RESEND_API_KEY=
# Where contact form submissions get emailed. Change any time — no code change needed.
CONTACT_EMAIL_TO=vishalsambare2004@gmail.com
# This is the FROM address for every outgoing email (contact form,
# enquiries, and OTP — see src/utils/mailer.ts, they all share this one
# var). It must be either Resend's own sandbox address
# (onboarding@resend.dev, which can only deliver to the Resend account
# owner's own inbox) or an address on a domain verified in Resend
# (resend.com/domains). craly.co is the verified production domain —
# production must use an address on it (e.g. noreply@craly.co), not
# onboarding@resend.dev and not an unverified domain/address, or Resend
# will reject the send with a 403.
CONTACT_EMAIL_FROM=Craly <noreply@craly.co>

# ─── File storage (KYC documents, worksite photos) ───────────────────────────
# Private object storage; files are only ever reached through short-lived
# signed URLs minted by the backend. One codebase, two providers — pick with
# STORAGE_PROVIDER (see src/storage/). Only the selected provider's variables
# are required; until they are all set, upload/signed-URL endpoints return 503.
#
#   r2 = Cloudflare R2 (Render)        — the default when unset or blank
#   s3 = AWS S3 (AWS EC2, IAM role)
STORAGE_PROVIDER=r2

# ── Cloudflare R2 — used when STORAGE_PROVIDER=r2 ──
# Setup: Cloudflare dashboard → R2 → Enable R2 → create a bucket → Manage API
# Tokens → Create API Token, scoped to that one bucket, "Object Read & Write".
# R2_ENDPOINT is https://<account-id>.r2.cloudflarestorage.com — the same
# account ID as R2_ACCOUNT_ID. R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY are
# SECRETS. Never commit real values here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# ── AWS S3 — used when STORAGE_PROVIDER=s3 ──
# Not secrets. Do NOT add AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: on EC2
# the AWS SDK gets temporary credentials from the instance IAM role
# (CralyEC2SSMRole, inline policy CralyS3MediaAccess). Static keys set in
# the environment would take precedence over the role — leave them unset.
# e.g. S3_BUCKET_NAME=craly-prod-media-2026-507941515127-ap-south-1-an
#      AWS_REGION=ap-south-1
S3_BUCKET_NAME=
AWS_REGION=

# ─── Phone OTP (MSG91 OTP Widget) — NOT part of the active signup flow ─────
# Signup verification is email-only. Phone number is still collected as a
# normal signup field, but is not itself verified — nothing in the active
# app imports src/utils/sms.ts right now. NOT REQUIRED for the app to run
# or for signup to work.
#
# This var (and its frontend counterparts, NEXT_PUBLIC_MSG91_WIDGET_ID /
# NEXT_PUBLIC_MSG91_TOKEN_AUTH — see frontend/.env.example) are kept
# documented here only so phone verification can be reintroduced later
# without rediscovering the setup: the MSG91 OTP Widget is a CLIENT-SIDE
# product — its JS SDK would run on the signup page, sending/verifying the
# phone code itself by talking to MSG91 directly from the browser, then
# handing the browser an access-token (JWT). This backend's only MSG91
# involvement would be confirming that access-token via MSG91's
# server-side verifyAccessToken API
# (POST https://control.msg91.com/api/v5/widget/verifyAccessToken,
# body: { authkey, "access-token" } — see src/utils/sms.ts). That's the
# MSG91 account Authkey (MSG91 dashboard → API — NOT the widget-scoped
# Token used on the frontend).
MSG91_AUTH_KEY=

# ─── WhatsApp (Meta WhatsApp Cloud API) ─────────────────────────────────────
# Server-side only — never expose these to the frontend (no NEXT_PUBLIC_ copy).
# src/utils/whatsapp.ts sends approved message templates for Craly events
# (see src/utils/whatsappNotifications.ts for the event → template map).
# If the first three are unset, WhatsApp sends are skipped with a warning and
# the rest of the app works normally.
# Setup: Meta for Developers → your app → WhatsApp → API Setup. Use a
# System User permanent token in production (temporary tokens expire in 24h).
WHATSAPP_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Needed by scripts/test_whatsapp.ts check (lists templates); not for sending.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Optional. Prepended to stored 10-digit phone numbers that have no country
# code (signup doesn't require one). Defaults to 91 (India).
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Optional kill switch: false = the API stops queueing WhatsApp jobs and the
# worker completes already-queued ones without sending. Credentials stay.
# Defaults to true.
WHATSAPP_ENABLED=true
# Optional, TESTING ONLY: when set, every WhatsApp message is sent to this
# number instead of the real recipient (e.g. while using Meta's test number
# against a database with real contractors' phone numbers). Leave EMPTY in
# production.
WHATSAPP_TEST_RECIPIENT=
# ─── WhatsApp queue + worker (pg-boss on this same Postgres database) ─────
# The API queues WhatsApp jobs into Postgres (schema "pgboss", created
# automatically); a separate worker process sends them (npm run worker —
# see ecosystem.config.js). No Redis.
#
# pg-boss needs a session-stable connection, so it does NOT use Neon's
# "-pooler" (PgBouncer) endpoint: by default it uses DATABASE_URL with
# "-pooler" removed from the host. Set this only to point it elsewhere.
QUEUE_DATABASE_URL=
# Worker tuning (defaults shown). Retries: 5 attempts total with exponential
# backoff starting at WHATSAPP_RETRY_DELAY_SECONDS, capped at the max.
WHATSAPP_WORKER_CONCURRENCY=2
WHATSAPP_WORKER_POLL_SECONDS=2
WHATSAPP_RETRY_DELAY_SECONDS=30
WHATSAPP_RETRY_DELAY_MAX_SECONDS=600
# Seconds before a job whose worker died mid-send becomes retryable, and how
# often the worker's maintenance checks for that.
WHATSAPP_JOB_EXPIRE_SECONDS=120
PGBOSS_SUPERVISE_INTERVAL_SECONDS=60
# Test-only, leave unset: isolated queue name, and a mock Meta URL (ignored
# when NODE_ENV=production). Used by scripts/test_whatsapp_queue.ts / _flow.ts.
# WHATSAPP_QUEUE_NAME=
# WHATSAPP_GRAPH_API_BASE_URL=

# Delivery-status webhook (GET/POST /api/webhooks/whatsapp). The verify token
# is any random string you also paste into Meta → WhatsApp → Configuration →
# Webhook; the app secret is Meta app → App settings → Basic → App secret.
# The webhook rejects all events (503) until both are set.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
