# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ─── PostgreSQL (postgres.js connection string) ───────────────────────────────
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://postgres:password@localhost:5432/craly

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (Next.js dev server)
ALLOWED_ORIGINS=http://localhost:3000

# ─── Frontend ────────────────────────────────────────────────────────────────
# Used to build absolute links back to the app in emails (e.g. "View Enquiry").
FRONTEND_URL=http://localhost:3000

# ─── Auth ────────────────────────────────────────────────────────────────────
# Secret used to sign JWTs. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Contact form email (Resend) ───────────────────────────────────────────────
# Get a free API key at https://resend.com/api-keys
RESEND_API_KEY=
# Where contact form submissions get emailed. Change any time — no code change needed.
CONTACT_EMAIL_TO=vishalsambare2004@gmail.com
# Must be onboarding@resend.dev unless you've verified a sending domain in Resend.
CONTACT_EMAIL_FROM=Craly <onboarding@resend.dev>

# ─── Cloudflare R2 (contractor document storage) ───────────────────────────────
# Private, S3-compatible object storage for Aadhaar/PAN and other verification
# documents. All five are required together — document upload/signed-URL
# endpoints return 503 until every one is set (see src/utils/r2.ts).
#
# Setup: Cloudflare dashboard → R2 → Enable R2 → create a bucket → Manage API
# Tokens → Create API Token, scoped to that one bucket, "Object Read & Write".
# R2_ENDPOINT is https://<account-id>.r2.cloudflarestorage.com — the same
# account ID as R2_ACCOUNT_ID. Never commit real values here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# ─── Phone OTP (MSG91 OTP Widget) ──────────────────────────────────────────
# MSG91's OTP Widget REST API (POST https://api.msg91.com/api/v5/widget/sendOtp
# and /verifyOtp, `authkey` header auth + widgetId) — see src/utils/sms.ts.
# Both calls are server-to-server only; there is no client-side widget SDK
# anywhere in this app. Unlike MSG91's older /api/v5/otp flow, the widget's
# default SMS template needs no DLT registration — but MSG91 itself now
# generates and verifies the phone OTP code (Craly never sees the plaintext
# code for phone; see the trust-model note atop src/utils/sms.ts). Email OTP
# is unaffected — Craly still generates, hashes, stores, and verifies that
# one itself. Both vars are required together; phone OTP send returns a
# clear error in production (and falls back to auto-accepting any 4-digit
# code in development only) until both are set.
#
# Setup: MSG91 dashboard → OTP → Widgets → create/open your widget (4-digit
# OTP, India, SMS enabled) → copy its Widget ID into MSG91_WIDGET_ID. Copy
# your account Auth Key (MSG91 dashboard → API) into MSG91_AUTH_KEY.
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
